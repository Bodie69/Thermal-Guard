# Thermal Guard backend settings. Copy to /opt/thermal-guard/.env and fill in.
# The real .env is not committed (see .gitignore).

# ---- Firebase ----
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.REGION.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT=/opt/thermal-guard/firebase-service-account.json
FIREBASE_HTTP_TIMEOUT_SECONDS=10

# ---- sensors (SHT31 behind a TCA9548A multiplexer) ----
SENSOR_MODE=sht31
TCA9548A_ADDRESS=0x70
ENTRANCE_TCA_CHANNEL=0
EXIT_TCA_CHANNEL=1
FRONT_TCA_CHANNEL=2
SHT31_ADDRESS=0x44
SHT31_SAMPLE_COUNT=3
SHT31_SAMPLE_DELAY_SECONDS=0.15
ENTRANCE_TEMP_OFFSET=0.0
ENTRANCE_HUM_OFFSET=0.0
EXIT_TEMP_OFFSET=0.0
EXIT_HUM_OFFSET=0.0
FRONT_TEMP_OFFSET=0.0
FRONT_HUM_OFFSET=0.0
READ_INTERVAL_SECONDS=3
HISTORY_INTERVAL_SECONDS=60

# ---- alarm thresholds ----
WARNING_TEMP_C=35.0
CRITICAL_TEMP_C=38.0
CRITICAL_CONFIRM_READS=3
RECOVERY_CONFIRM_READS=3
OFFLINE_CONFIRM_ERRORS=4

# ---- siren relay ----
RELAY_GPIO=17
RELAY_ACTIVE_HIGH=false
RELAY_FAILSAFE_OFF_IF_ALL_SENSORS_OFFLINE=false
SIREN_OFF_REVERT_MINUTES=30

# ---- SIM800L GSM modem ----
SIM800L_ENABLED=true
SIM800L_PORT=/dev/serial0
SIM800L_BAUD=9600
SIM800L_POLL_SECONDS=3
SIM800L_STATUS_SECONDS=15

# ---- offline SMS (works without internet) ----
# Numbers that ALWAYS get alert SMS, even with no internet and even if the
# app's SMS switch is off. Comma separated, e.g. 09171234567,09281234567
SMS_FALLBACK_RECIPIENTS=
# Alert types sent to those numbers (default: all alert types)
# SMS_FALLBACK_TYPES=
SMS_RETRY_SECONDS=30
SMS_MAX_AGE_MINUTES=120

# ---- web server ----
HOST=0.0.0.0
PORT=8080
