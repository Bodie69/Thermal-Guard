<?xml version="1.0" encoding="utf-8"?>
<!-- One label/value line. Every detail on every card uses this row, so the columns always line up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="true" android:orientation="horizontal" android:paddingVertical="4dp">
    <TextView android:id="@+id/tvLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="4" android:textColor="@color/tg_muted" android:textSize="12sp"/>
    <TextView android:id="@+id/tvValue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="6" android:fontFeatureSettings="tnum" android:gravity="end" android:textColor="@color/tg_text" android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
